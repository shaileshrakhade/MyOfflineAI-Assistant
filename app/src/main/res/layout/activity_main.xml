<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="Subnet Voice Assistant" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="36dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/status" android:text="Ready. Tap the microphone and speak." android:textSize="16sp" android:gravity="center" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/listenButton" android:text="Speak command" android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/commandInput" android:hint="Or type a command" android:layout_marginTop="20dp" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/runButton" android:text="Run command" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:text="Examples: open YouTube • set alarm for 7:00 AM • note buy milk • call Alex" android:gravity="center" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>

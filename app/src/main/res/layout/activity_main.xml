<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sb_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="18dp">

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:contentDescription="Subnet Assistant SB logo"
                android:src="@drawable/sb_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUBNET"
                    android:textColor="@color/sb_text"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your personal assistant"
                    android:textColor="@color/sb_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_surface"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/setupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Setup required"
                android:textColor="@color/sb_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Hello! I am Subnet."
                android:textColor="@color/sb_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/learningStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Memory: 0 learned phrases • 0 saved tasks"
                android:textColor="@color/sb_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/status_surface"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:padding="14dp"
                android:text="Ready when you are. Speak or type a command."
                android:textColor="@color/sb_text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/listenButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/sb_primary"
                android:text="🎙  Start wake listening"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/commandInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/input_surface"
                android:hint="Type a command in English"
                android:inputType="textCapSentences"
                android:minHeight="52dp"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="@color/sb_text"
                android:textColorHint="@color/sb_muted" />

            <Button
                android:id="@+id/runButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/sb_secondary"
                android:text="Run command"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="Personalise Subnet"
            android:textColor="@color/sb_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/setupButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/sb_card_button"
            android:text="👤  Owner setup"
            android:textAllCaps="false"
            android:textColor="@color/sb_text" />

        <Button
            android:id="@+id/exportButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/sb_card_button"
            android:text="↑  Export learned commands"
            android:textAllCaps="false"
            android:textColor="@color/sb_text" />

        <Button
            android:id="@+id/importButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/sb_card_button"
            android:text="↓  Import learned commands"
            android:textAllCaps="false"
            android:textColor="@color/sb_text" />

        <Button
            android:id="@+id/suggestButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/sb_accent"
            android:text="💡  Suggest a feature"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="14dp"
            android:background="@drawable/status_surface"
            android:text="Try: “Open WhatsApp”  •  “Call Alex”  •  “Note buy groceries”  •  “Teach my office as work”"
            android:textColor="@color/sb_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="SUBNETBYTES  •  Built to learn with you"
            android:textColor="@color/sb_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
